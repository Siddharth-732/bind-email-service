PORT=4000
REDIS_URL=
MONGODB_URI=

# SMTP relay - works with any SMTP provider (Brevo, Gmail, SMTP2GO, SES...)
# Brevo free tier: 300 emails/day, no credit card, no domain required.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=          # Brevo dashboard -> SMTP & API -> SMTP tab -> login
SMTP_PASS=          # Brevo dashboard -> SMTP & API -> SMTP tab -> generate SMTP key
EMAIL_FROM_ADDRESS= # must be a provider-verified sender address
